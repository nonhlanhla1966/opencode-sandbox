<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/chatBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="?attr/chatSurface"
        android:paddingHorizontal="8dp"
        android:paddingVertical="8dp">

        <Button
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="40dp"
            android:text="←" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/conversations_title"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="?attr/chatTextPrimary" />

        <Button
            android:id="@+id/btn_delete_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="40dp"
            android:paddingHorizontal="10dp"
            android:text="@string/action_delete_all"
            android:textColor="@color/danger" />
    </LinearLayout>

    <EditText
        android:id="@+id/et_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginVertical="8dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp"
        android:inputType="text"
        android:hint="@string/search_hint"
        android:background="@drawable/composer_bg"
        android:textSize="15sp"
        android:textColor="?attr/chatTextPrimary"
        android:textColorHint="?attr/chatTextSecondary" />

    <ListView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="?attr/chatDivider"
        android:dividerHeight="1dp" />

    <TextView
        android:id="@+id/txt_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="24dp"
        android:gravity="center"
        android:textSize="14sp"
        android:textColor="?attr/chatTextSecondary"
        android:text="@string/conversations_empty" />
</LinearLayout>