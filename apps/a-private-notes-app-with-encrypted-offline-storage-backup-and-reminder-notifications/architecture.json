  "engine": "sqlite",
  "entities": [
   {
    "fields": "text, timestamp",
    "name": "habit tracker"
   },
   {
    "fields": "text, timestamp",
    "name": "notes"
   }
  ],
  "versioned_migrations": true
 },
 "layers": [
  "ui",
  "logic",
  "persistence",
  "network"
 ],
 "module_compat": {
  "json": {
   "api": 21,
   "level": "OFFLINE",
   "test": "unit"
  },
  "notifications": {
   "api": 26,
   "level": "OFFLINE",
   "test": "unit"
  },
  "settings": {
   "api": 21,
   "level": "OFFLINE",
   "test": "unit"
  },
  "storage-sqlite": {
   "api": 21,
   "level": "OFFLINE",
   "test": "unit+db"
  },
  "text": {
   "api": 21,
   "level": "OFFLINE",
   "test": "unit"
  },
  "time": {
   "api": 21,
   "level": "OFFLINE",
   "test": "unit"
  },
  "validation": {
   "api": 21,
   "level": "OFFLINE",
   "test": "unit"
  }
 },
 "modules": [
  "storage-sqlite",
  "notifications",
  "json",
  "text",
  "validation",
  "time",
  "settings"
 ],
 "name": "A private notes app with encrypted offline storage, backup and reminder notifications",
 "permissions": [
  {
   "note": "runtime request on API>=33",
   "permission": "android.permission.POST_NOTIFICATIONS"
  }
 ],
 "release": {
  "artifact": "debug APK",
  "signing": "CI debug-signed APK (installable, unsigned=false)",
  "verify": [
   "compile",
   "unit tests",
   "lint",
   "resource/XML",
   "manifest",
   "security scan",
   "apk badging",
   "apksigner verify",
   "sha256"
  ]
 },
 "reproducible": {
  "agp": "8.5.2",
  "gradle": "8.7 wrapper (or later pinned)",
  "jdk": "17 (Temurin)",
  "kotlin": "n/a (Java-first)",
  "sdk": "compileSdk 34"
 },
 "security": {
  "allow_backup": false,
  "api_keys": "never hardcoded; user-supplied via Settings, stored encrypted",
  "exported_components": "only launcher exported",
  "logging": "no secrets in logs",
  "tls": "always-on certificate validation"
 },
 "testing": {
  "api": false,
  "database": true,
  "none": false,
  "ui_smoke": true,
  "unit": true
 },
 "ui": {
  "min_sdk": 21,
  "nav": "Single-activity flow with back navigation between screens.",
  "screens": [
   "Home",
   "Notifications"
  ],
  "theme": "Material-ish, dark-mode aware (system), system fonts"
 }
}